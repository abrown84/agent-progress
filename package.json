{
  "name": "agent-progress-overlay",
  "version": "1.1.0",
  "description": "Desktop overlay + cloud dashboard for AI agent task progress. Zero AI token usage in the app.",
  "author": "Alex Brown",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abrown84/agent-progress"
  },
  "keywords": [
    "ai-agent",
    "claude",
    "progress",
    "overlay",
    "tauri",
    "desktop",
    "visualization",
    "sse",
    "cloud"
  ],
  "private": false,
  "type": "module",
  "scripts": {
    "start": "tauri dev",
    "build": "tauri build",
    "dev:frontend": "vite",
    "dev:web": "vite --config vite.config.web.ts",
    "build:frontend": "tsc && vite build",
    "build:web": "tsc --noEmit && vite build --config vite.config.web.ts && mv dist-web/web.html dist-web/index.html",
    "dev:server": "npm --prefix server run dev",
    "smoke": "npm --prefix server run smoke",
    "tauri": "tauri",
    "help": "echo Available commands: npm start | npm run build | npm run dev:frontend | npm run build:web | npm run dev:server | npm run smoke"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.18",
    "@tauri-apps/api": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
