# Copy to .env for docker-compose (never commit .env)
SESSION_SECRET=replace-with-long-random-string
ALLOW_SIGNUPS=false
SEED_OWNER_EMAIL=alex@example.com
SEED_OWNER_PASSWORD=replace-me
SEED_WORKSPACE_NAME=Alex Workspace
SEED_WORKSPACE_SLUG=alex
CORS_ORIGIN=https://progress.brwnindustries.com
# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alex@example.com
